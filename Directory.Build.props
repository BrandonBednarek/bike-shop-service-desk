<Project>
  <!-- Applies to every project under this folder. Code-style rules from .editorconfig
       (such as explicit types instead of `var`) run during `dotnet build`, not only in
       the editor, and warnings fail the build so they can't quietly pile up. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Security advisories published against a dependency stay visible as warnings rather
         than errors, so a newly published advisory can't break the Docker build on an
         unchanged commit. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
